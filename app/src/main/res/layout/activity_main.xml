<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header con Logo/Icono -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <!-- Icono de reciclaje -->
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="♻️"
                android:textSize="50sp"
                android:gravity="center"
                android:background="@drawable/circle_background"
                android:elevation="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EcoTrack ECOLIM"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:layout_marginTop="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestión de Residuos Sólidos"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Tarjeta de Bienvenida -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#E8F5E9">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👋 Bienvenido"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registra y gestiona los residuos de forma digital y eficiente"
                    android:textSize="13sp"
                    android:textColor="#555555"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botón Registrar Residuo -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#4CAF50">

            <Button
                android:id="@+id/btnRegistrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 Registrar Residuo"
                android:textSize="17sp"
                android:textStyle="bold"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:padding="18dp"
                android:elevation="0dp"/>
        </androidx.cardview.widget.CardView>

        <!-- Botón Ver Reportes -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#2196F3">

            <Button
                android:id="@+id/btnReportes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Ver Reportes"
                android:textSize="17sp"
                android:textStyle="bold"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:padding="18dp"
                android:elevation="0dp"/>
        </androidx.cardview.widget.CardView>

        <!-- Botón Estadísticas -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FF9800">

            <Button
                android:id="@+id/btnEstadisticas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📈 Estadísticas"
                android:textSize="17sp"
                android:textStyle="bold"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                android:padding="18dp"
                android:elevation="0dp"/>
        </androidx.cardview.widget.CardView>

        <!-- Info Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="© 2026 ECOLIM S.A.C.\nComprometidos con el medio ambiente"
            android:textSize="11sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>